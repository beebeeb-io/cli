# Copy to /etc/beebeeb-prober/prober.env, chmod 600, chown prober:prober.
# NEVER commit the filled-in copy — prober/prober.env is gitignored.
BOT_PROBE_1_EMAIL=bot-probe-1@beebeeb.io
BOT_PROBE_1_PASSWORD=replace-me
BOT_PROBE_1_RECOVERY_PHRASE=replace me with the twenty four word phrase
API_BASE_URL=https://api.beebeeb.io
PROM_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
BB_PROBER_REPO=/opt/beebeeb-prober/cli
# Set to 1 to pause every bot without touching the timer.
BB_BOTS_DISABLED=0
